# Application Environment
NODE_ENV=development
PORT=3000

# Security & Traffic Protection
API_KEY="your-secure-x-api-key-here"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/jastipops?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="your-jwt-access-secret-minimum-32-characters"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN="*"
